        <mxCell id="sta17" value="&lt;b&gt;Datos&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1">
