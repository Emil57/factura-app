        <mxCell id="arq34" value="&lt;b&gt;Datos · PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Contenedor db · postgres:16-alpine · :5432 · volumen pgdata&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1">
