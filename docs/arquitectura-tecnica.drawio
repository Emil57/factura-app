          <mxGeometry x="675" y="260" width="610" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sta16" value="&lt;b&gt;Python&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;3.12 (slim)&lt;/font&gt; — lenguaje del API&lt;br&gt;&lt;b&gt;FastAPI&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;0.115.6&lt;/font&gt; — routers, Depends(), OpenAPI en /docs&lt;br&gt;&lt;b&gt;Uvicorn[standard]&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;0.34.0&lt;/font&gt; — servidor ASGI&lt;br&gt;&lt;b&gt;Pydantic&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;2.10.4&lt;/font&gt; — esquemas *In/*Out y validadores (AfterValidator)&lt;br&gt;&lt;b&gt;SQLAlchemy&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;2.0.36&lt;/font&gt; — ORM tipado (Mapped), bloqueo SELECT … FOR UPDATE&lt;br&gt;&lt;b&gt;psycopg[binary]&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;3.2.3&lt;/font&gt; — driver de PostgreSQL&lt;br&gt;&lt;b&gt;PyJWT&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;2.10.1&lt;/font&gt; — tokens JWT HS256&lt;br&gt;&lt;b&gt;python-multipart&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;0.0.20&lt;/font&gt; — formulario OAuth2 del login&lt;br&gt;&lt;b&gt;httpx&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;0.28.1&lt;/font&gt; — cliente HTTP hacia Facturama&lt;br&gt;&lt;b&gt;Librería estándar&lt;/b&gt; — decimal (impuestos) · hashlib PBKDF2 (contraseñas) · xml.etree (XML) · zoneinfo · base64" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;spacingTop=6;" vertex="1" parent="sta15">
          <mxGeometry x="15" y="36" width="580" height="239" as="geometry" />
