        <mxCell id="sta18" value="&lt;b&gt;PostgreSQL&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;16 (alpine)&lt;/font&gt; — base de datos relacional&lt;br&gt;&lt;b&gt;Esquema&lt;/b&gt; — 10 tablas, ver página «Modelo de datos»&lt;br&gt;&lt;b&gt;Tipos monetarios&lt;/b&gt; — numeric(18,2) importes · numeric(18,6) cantidades, precios y tasas&lt;br&gt;&lt;b&gt;Volumen Docker&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;pgdata&lt;/font&gt; — persistencia de datos&lt;br&gt;&lt;b&gt;Migraciones&lt;/b&gt; — create_all al iniciar (Alembic pendiente, ver ROADMAP)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;spacingTop=6;" vertex="1" parent="sta17">
